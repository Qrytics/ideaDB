# IdeaDB Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit the .env file — it is in .gitignore.

# --- Discord ---
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: The name or ID of a specific Discord channel where the bot
# will post auto-generated idea summaries. Leave blank to disable.
IDEA_CHANNEL=

# --- Groq ---
# Your Groq API key (from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# --- Database ---
# Path to the SQLite database file (default: ideadb.sqlite)
DB_PATH=ideadb.sqlite

# --- Behaviour ---
# Minimum number of new entries before the bot auto-generates ideas (0 = disabled)
AUTO_IDEA_THRESHOLD=50
