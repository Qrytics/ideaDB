# IdeaDB Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit the .env file — it is in .gitignore.

# --- Discord ---
# Your Discord bot token (from https://discord.com/developers/applications → your app → Bot → Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Comma-separated list of channel names or IDs the bot should collect messages from.
# Leave blank to collect from every channel the bot can read.
# Example: INPUT_CHANNELS=general,brainstorming,random
# Example: INPUT_CHANNELS=1234567890,9876543210
INPUT_CHANNELS=

# The name or ID of the single Discord channel where the bot posts auto-generated
# idea summaries.  Leave blank to disable auto-posting.
IDEA_CHANNEL=idea-generation

# --- Groq ---
# Your Groq API key (from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# --- Database ---
# Path to the SQLite database file (default: ideadb.sqlite)
DB_PATH=ideadb.sqlite

# --- Behaviour ---
# How often (in minutes) the bot checks for new messages and auto-generates ideas.
# The bot only posts if at least one new message has been collected since the last run.
# Set to 0 to disable timer-based auto-generation (default: 10).
AUTO_IDEA_INTERVAL=10
